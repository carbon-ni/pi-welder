{
  "name": "pi-welder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pi extension that registers harness-level tool failures",
  "scripts": {
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test",
    "eval:direction": "node --experimental-strip-types scripts/direction-evals.ts report",
    "eval:tune": "node --experimental-strip-types scripts/jev-tune.ts probe",
    "shadow:stats": "node --experimental-strip-types scripts/shadow-stats.ts stats",
    "eval:read-path": "node --experimental-strip-types scripts/read-path-eval.ts pairs",
    "eval:routing": "node --experimental-strip-types scripts/routing-eval.ts run",
    "eval:intent": "node --experimental-strip-types scripts/intent-eval.ts run",
    "mine:episodes": "node --experimental-strip-types scripts/episode-mine.ts run",
    "eval:mismatch": "node --experimental-strip-types scripts/mismatch-eval.ts run",
    "eval:occurrence": "node --experimental-strip-types scripts/occurrence-eval.ts run",
    "eval:tool-routing": "node --experimental-strip-types scripts/tool-routing-eval.ts run"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
